# ============================================================
# Google Gmail OAuth2 integration (Email Center -> Settings)
# ============================================================
# 1. Go to https://console.cloud.google.com/apis/credentials
#    -> Create Credentials -> OAuth client ID -> Web application
# 2. Add this redirect URI (must match exactly):
#    http://localhost:3001/api/email/gmail/callback
# 3. Enable the Gmail API:
#    https://console.cloud.google.com/apis/library/gmail.googleapis.com
# 4. Copy the client ID and client secret below, restart the app,
#    then open Email Center -> Settings -> "Sign in with Google".
# ============================================================

# Required in production: generate a long random value and keep it private.
TOKEN_SECRET=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/email/gmail/callback
